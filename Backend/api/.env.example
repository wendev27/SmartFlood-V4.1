# SmartFlood V3.2 backend API configuration
PORT=5000
CORS_ORIGINS=http://localhost:3000

MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/database
MONGODB_DB=smartflood

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

SMARTFLOOD_SESSION_SECRET=replace-with-a-long-random-secret

# Existing FastAPI AI backend, started separately from Backend/ai.
AI_BACKEND_URL=http://localhost:8000

NODE_ENV=development

# Campaign QR encryption: base64 encoding of exactly 32 random bytes.
# Configure before approving new campaigns; retain the key for existing QR retrieval.
CAMPAIGN_QR_ENCRYPTION_KEY=
